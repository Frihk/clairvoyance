{
  "info": {
    "name": "ProofPass API",
    "description": "All endpoints for the ProofPass backend. Set the `base_url` variable to your server address.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",     "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "cred_id",      "value": "" },
    { "key": "team_id",      "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health" }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Alice Wanjiku\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/refresh" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"<paste refresh token here>\"\n}"
            }
          }
        },
        {
          "name": "Profile (auth required)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/profile" }
          }
        },
        {
          "name": "Logout (auth required)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/logout" }
          }
        }
      ]
    },
    {
      "name": "Credentials",
      "item": [
        {
          "name": "Issue Credential (issuer role required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('cred_id', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/credentials/issue" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"alice@example.com\",\n  \"credential_type\": \"certificate\",\n  \"title\": \"Solidity Developer — BuildKE 2025\",\n  \"description\": \"Issued for outstanding smart contract work at BuildKE Hackathon 2025.\",\n  \"issue_date\": \"2025-05-20T00:00:00Z\",\n  \"skills\": [\"Solidity\", \"Go\", \"Blockchain\"]\n}"
            }
          }
        },
        {
          "name": "Verify Credential (PUBLIC — no auth)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/credentials/verify/{{cred_id}}" }
          }
        },
        {
          "name": "My Credentials (auth required)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/credentials/mine" }
          }
        },
        {
          "name": "Issued By Me (auth required)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/credentials/issued" }
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "Get Team (PUBLIC — accepts UUID or slug)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/teams/{{team_id}}" }
          }
        },
        {
          "name": "Get Team Credentials (PUBLIC)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/teams/{{team_id}}/credentials" }
          }
        }
      ]
    }
  ]
}