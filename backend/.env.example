# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080

# ── Database ────────────────────────────────────────────────────────────────────
# Get this from your Supabase project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ── Auth ────────────────────────────────────────────────────────────────────────
# Generate a strong random string — e.g. openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY_MINUTES=10

# ── Blockchain ──────────────────────────────────────────────────────────────────
# Leave these empty during development — server will use MockBlockchainClient.
# Fill them in once Person 1 deploys the contract to Polygon Amoy.
RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0xYourDeployedContractAddress
# The backend wallet that is authorised to call issueCredential() on the contract.
# Must match the address that Person 1 called addIssuer() with.
# Never commit the real key — use environment injection on Railway/Render.
PRIVATE_KEY=0xYourBackendWalletPrivateKey

# ── CORS ────────────────────────────────────────────────────────────────────────
# Set to your frontend URL on Vercel once deployed
ALLOWED_ORIGIN=http://localhost:3000
